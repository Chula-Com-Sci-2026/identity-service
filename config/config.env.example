NODE_ENV=development
PORT=5000
DB_HOST=postgres
DB_PORT=5432
DB_USER=identity
DB_PASSWORD=replace-with-local-secret
DB_NAME=identity
DB_SSL=false
ACCESS_TOKEN_SECRET=replace-with-local-access-signing-secret
REFRESH_TOKEN_SECRET=replace-with-different-local-refresh-secret
JWT_ISSUER=cant-run-alone-local
JWT_AUDIENCE=cant-run-alone-services
ACCESS_TOKEN_EXPIRY=15m
REQUIRE_PHONE_VERIFICATION=true
AUTO_SEND_PHONE_OTP=true
OTP_DELIVERY=console
AUTO_MIGRATE=true
COOKIE_SECURE=false
RABBITMQ_REQUIRED=true
RABBITMQ_URL=amqp://identity:replace-with-local-broker-secret@rabbitmq:5672
NOTIFICATION_QUEUE=identity.email.v1
FRONTEND_URL=http://localhost:5173
BROKER_PASSWORD=replace-with-local-broker-secret
EMAIL_DELIVERY=console
